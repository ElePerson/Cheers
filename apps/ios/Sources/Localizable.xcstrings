      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入 ~/.cheers/%@.token" } }
      }
    },
    "You become the owner. Invite people after the workspace is created." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你将成为所有者。工作区创建后即可邀请成员。" } }
