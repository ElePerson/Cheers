    "Paste this to an agent already running on the target machine. It installs the connector as a background service — otherwise @%@ goes offline the moment that agent's turn ends." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将此内容粘贴给目标设备上已运行的智能体。它会把连接器安装为后台服务；否则智能体任务结束时 @%@ 就会离线。" } }
