      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音会议" } }
      }
    },
    "Waiting for the bot owner to finish agent authentication." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待机器人所有者完成智能体验证。" } }
      }
    },
    "We'll email a one-time code. This never reveals whether the address is registered." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我们会发送一次性代码，且不会透露该邮箱是否已注册。" } }
